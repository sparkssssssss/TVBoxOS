<?xml version="1.0" encoding="utf-8"?>
<!--
  Focus highlight overlay: when the card root gains focus, a translucent
  white layer covers the card content so the whole card visibly "lights up"
  on top of the purple focus border. It is a pure static drawable state
  change (no scale/animation), so text is never re-sampled and no jitter is
  reintroduced. Used via a child FrameLayout with duplicateParentState=true.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="10mm" />
            <solid android:color="@color/color_33FFFFFF" />
        </shape>
    </item>
    <item android:state_focused="false">
        <shape>
            <corners android:radius="10mm" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
